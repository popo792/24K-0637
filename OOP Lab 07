// Task 01
#include <iostream>
using namespace std;

class Device {
protected:
    int deviceID;
    string deviceName;
    bool status;
    string location;
public:
    Device(int id, string name, bool stat, string loc = "") : deviceID(id), deviceName(name), status(stat), location(loc) {}
    virtual void turnOn() { status = true; }
    virtual void turnOff() { status = false; }
    virtual void getStatus() {}
    virtual void displayInfo() {}
};

class Light : public Device {
    int brightnessLevel;
    string colorMode;
public:
    Light(int id, string name, bool stat, string loc, int brightness, string color) : Device(id, name, stat, loc), brightnessLevel(brightness), colorMode(color) {}
    void displayInfo() {
        cout << "Light: " << deviceName << " Brightness: " << brightnessLevel << " Color: " << colorMode << endl;
    }
};

class Thermostat : public Device {
    float temperature;
    string mode;
    float targetTemperature;
public:
    Thermostat(int id, string name, bool stat, string loc, float temp, string m, float target) : Device(id, name, stat, loc), temperature(temp), mode(m), targetTemperature(target) {}
    void getStatus() {
        cout << "Thermostat Temperature: " << temperature << endl;
    }
};

class SecurityCamera : public Device {
    string resolution;
    bool recordingStatus;
    bool nightVisionEnabled;
public:
    SecurityCamera(int id, string name, bool stat, string loc, string res, bool rec, bool night) : Device(id, name, stat, loc), resolution(res), recordingStatus(rec), nightVisionEnabled(night) {}
    void turnOn() {
        status = true;
        recordingStatus = true;
    }
};
class SmartPlug : public Device {
    float powerConsumption;
    int timerSetting;
public:
    SmartPlug(int id, string name, bool stat, string loc, float power, int timer) : Device(id, name, stat, loc), powerConsumption(power), timerSetting(timer) {}
    void turnOff() {
        status = false;
        cout << "Logging Power Usage: " << powerConsumption << endl;
    }
};

// Task 02
class Product {
protected:
    int productID;
    string productName;
    float price;
    int stockQuantity;
public:
    Product(int id, string name, float p, int qty = 0) : productID(id), productName(name), price(p), stockQuantity(qty) {}
    virtual void applyDiscount() {}
    virtual float calculateTotalPrice(int quantity) { return price * quantity; }
    virtual void displayProductInfo() {}
};

class Electronics : public Product {
    int warrantyPeriod;
    string brand;
public:
    Electronics(int id, string name, float p, int qty, int warranty, string b) : Product(id, name, p, qty), warrantyPeriod(warranty), brand(b) {}
    void displayProductInfo() {
        cout << "Electronics: " << productName << " Brand: " << brand << " Warranty: " << warrantyPeriod << endl;
    }
};

class Clothing : public Product {
    string size;
    string color;
    string fabricMaterial;
public:
    Clothing(int id, string name, float p, int qty, string s, string c, string f) : Product(id, name, p, qty), size(s), color(c), fabricMaterial(f) {}
    void applyDiscount() {
        price *= 0.9;
    }
};

class FoodItem : public Product {
    string expirationDate;
    int calories;
public:
    FoodItem(int id, string name, float p, int qty, string date, int cal) : Product(id, name, p, qty), expirationDate(date), calories(cal) {}
    float calculateTotalPrice(int quantity) {
        if (quantity > 10) return quantity * price * 0.85;
        return quantity * price;
    }
};

// Task 03
class Ticket {
protected:
    int ticketID;
    string passengerName;
    float price;
    string date;
    string destination;
public:
    Ticket(int id, string name, float p, string d, string dest) : ticketID(id), passengerName(name), price(p), date(d), destination(dest) {}
    virtual void reserve() {}
    virtual void cancel() {}
    virtual void displayTicketInfo() {}
};

class FlightTicket : public Ticket {
    string airlineName;
    int flightNumber;
    string seatClass;
public:
    FlightTicket(int id, string name, float p, string d, string dest, string airline, int flight, string seat) : Ticket(id, name, p, d, dest), airlineName(airline), flightNumber(flight), seatClass(seat) {}
    void displayTicketInfo() {
        cout << "Flight: " << airlineName << " Flight No: " << flightNumber << " Seat Class: " << seatClass << endl;
    }
};

class TrainTicket : public Ticket {
    string trainNumber;
    string coachType;
    string departureTime;
public:
    TrainTicket(int id, string name, float p, string d, string dest, string train, string coach, string time) : Ticket(id, name, p, d, dest), trainNumber(train), coachType(coach), departureTime(time) {}
    void reserve() {
        cout << "Auto-assigning seat for Train: " << trainNumber << endl;
    }
};

class BusTicket : public Ticket {
    string busCompany;
    int seatNumber;
public:
    BusTicket(int id, string name, float p, string d, string dest, string company, int seat) : Ticket(id, name, p, d, dest), busCompany(company), seatNumber(seat) {}
    void cancel() {
        cout << "Last-minute refund for Bus: " << busCompany << endl;
    }
};

class ConcertTicket : public Ticket {
    string artistName;
    string venue;
    string seatType;
public:
    ConcertTicket(int id, string name, float p, string d, string dest, string artist, string v, string seat) : Ticket(id, name, p, d, dest), artistName(artist), venue(v), seatType(seat) {}
    void displayTicketInfo() {
        cout << "Concert: " << artistName << " Venue: " << venue << " Seat: " << seatType << endl;
    }
};

