            DataBaseConnector<string> db2("slow_db");
            cout<<"Attempting to slow database"<<endl;
            db2.connect();
        }catch(QueryTimeoutException &e){
            cout<<"Caught a general database Exception : "<<e.what()<<endl;
        }
        return 0;
    }

