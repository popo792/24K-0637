// Task 01
#include <iostream>
#include <string>
using namespace std;

class Patient {
public:
    string name;
    string id;
    virtual void displayTreatment() = 0;
    virtual void calculateCost() = 0;
    virtual ~Patient() {}
};

class InPatient : public Patient {
public:
    void displayTreatment() override {
        cout << "InPatient Treatment: Surgery and overnight stay\n";
    }
    void calculateCost() override {
        cout << "InPatient Cost: $5000\n";
    }
};

class OutPatient : public Patient {
public:
    void displayTreatment() override {
        cout << "OutPatient Treatment: Consultation and medication\n";
    }
    void calculateCost() override {
        cout << "OutPatient Cost: $300\n";
    }
};

int main_task1() {
    InPatient ip;
    ip.name = "John";
    ip.id = "IP1001";
    OutPatient op;
    op.name = "Alice";
    op.id = "OP2001";

    Patient* p1 = &ip;
    Patient* p2 = &op;

    p1->displayTreatment();
    p1->calculateCost();
    p2->displayTreatment();
    p2->calculateCost();

    return 0;
}

