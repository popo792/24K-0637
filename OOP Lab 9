};

class Thermometer : public WeatherSensor {
public:
    void readData() override {
        cout << "Thermometer Reading: 22.5°C\n";
    }
    void displayReport() override {
        cout << "Thermometer Report: Normal temperature\n";
    }
};

class Barometer : public WeatherSensor {
public:
    void readData() override {
        cout << "Barometer Reading: 1012 hPa\n";
    }
    void displayReport() override {
        cout << "Barometer Report: Stable atmospheric pressure\n";
    }
};

int main_task4() {
    Thermometer t;
    Barometer b;

    WeatherSensor* s1 = &t;
    WeatherSensor* s2 = &b;

    s1->readData();
    s1->displayReport();
    s2->readData();
    s2->displayReport();

    return 0;
}

// Task 05
#include <iostream>
#include <string>
using namespace std;

class Shipment {
protected:
    string trackingNumber;
    double weight;

public:
    Shipment(string tn, double w) : trackingNumber(tn), weight(w) {}
    virtual void showDetails() = 0;
    virtual double estimateDeliveryTime() = 0;
    virtual ~Shipment() {}
};

class AirFreight : public Shipment {
public:
    AirFreight(string tn, double w) : Shipment(tn, w) {}
    void showDetails() override {
        cout << "Air Freight - Tracking Number: " << trackingNumber << ", Weight: " << weight << " kg" << endl;
    }
    double estimateDeliveryTime() override {
        return weight * 0.5;
    }
};

class GroundShipment : public Shipment {
public:
    GroundShipment(string tn, double w) : Shipment(tn, w) {}
    void showDetails() override {
        cout << "Ground Shipment - Tracking Number: " << trackingNumber << ", Weight: " << weight << " kg" << endl;
    }
    double estimateDeliveryTime() override {
        return weight * 1.5;
    }
};

int main() {
    Shipment* s1 = new AirFreight("AF123", 10.0);
    Shipment* s2 = new GroundShipment("GS456", 10.0);

    s1->showDetails();
    cout << "Estimated Delivery Time: " << s1->estimateDeliveryTime() << " hours" << endl;

    s2->showDetails();
    cout << "Estimated Delivery Time: " << s2->estimateDeliveryTime() << " hours" << endl;

    delete s1;
    delete s2;

    return 0;
}
